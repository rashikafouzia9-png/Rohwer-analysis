#!/bin/bash
set -e

R -e "IRkernel::installspec(user = FALSE)" || true

# in environment.yml, but the Jupyter kernelspec still needs registering)
python -m octave_kernel.install --user || python -m octave_kernel install || true

octave --no-gui --eval "pkg install -forge io" || true
octave --no-gui --eval "pkg install -forge statistics" || true
octave --no-gui --eval "pkg install -forge statistics-resampling" || \
  octave --no-gui --eval "pkg install https://github.com/gnu-octave/statistics-resampling/archive/refs/heads/master.zip"

octave --no-gui --eval "pkg load statistics-resampling; which bootridge"
